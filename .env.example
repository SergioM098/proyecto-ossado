# Copia este archivo como .env.local para probar en local.
# En Vercel, crea estas mismas variables en Project Settings > Environment Variables.

# Contraseña para entrar a la interfaz web (usa una larga)
APP_PASSWORD=

# Clave para firmar la sesion: minimo 32 caracteres aleatorios
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Servidores MySQL (JSON en una sola linea). Las bases de cada servidor se descubren solas,
# y en los selects se muestran como "NIT - nombre" leyendo la tabla empresas de cada base.
# El id no puede tener "/".
DB_SERVERS=[{"id":"s66","label":"Servidor 66","host":"66.94.100.31","port":3306,"user":"USUARIO","password":"CLAVE"},{"id":"s209","label":"Servidor 209","host":"209.126.87.129","port":3306,"user":"USUARIO","password":"CLAVE"}]

# Base de control de licencias (pestaña Licencias). No aparece en los selectores de sincronizar.
LICENSE_DB={"host":"HOST","port":3306,"user":"USUARIO","password":"CLAVE","database":"dbcontrol"}
